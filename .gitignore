# 依赖与构建产物
node_modules
dist
dist-ssr
*.local
.DS_Store

# 出包产物（APK / EXE 等，体积大，本地留档即可）
out/

# 本机构建助手（含 C:\VSBuildTools / Windows Kits 等绝对路径，勿入库）
build-desktop.bat

# 文档生成流水线中间产物（截图/HTML，可重新生成，体积大）
output/

# Tauri
src-tauri/target
src-tauri/gen/android/app/build
src-tauri/gen/android/.gradle
src-tauri/gen/android/app/.cxx

# 签名密钥（绝不入库）
src-tauri/*.jks
src-tauri/*.keystore

# 工具链缓存 / 临时目录
.cache/
.chrome-tmp/
.trae-html-share-packages/

# 本地工作数据（记忆、测试截图、日志）
.workbuddy/
regression-shots/
shots/
*.log

# WorkBuddy 应用卡片临时文件
.wbapp_*.genie
