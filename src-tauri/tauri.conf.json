{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "山河城邑",
  "version": "0.9.21",
  "identifier": "com.ankon.shanhechengyi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "山河城邑 · 旅行记录",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "山河城邑",
    "category": "Education",
    "shortDescription": "3D 旅行记录",
    "longDescription": "山河城邑：以 3D 地形板块浏览省 / 市 / 区县，随手记下游记、时间线、照片墙与收藏足迹的个人旅行记录本。所有数据留在本机。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
